# Copia este archivo como .env (no se sube al repositorio).
PORT=3000

# Supabase (Settings → API). Si se dejan vacías, la API arranca en modo demostración en memoria.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para el enlace de recuperación de contraseña)
PUBLIC_URL=http://localhost:5173

# Solo modo memoria: clave para firmar JWT (si falta se genera una aleatoria al iniciar)
JWT_SECRET=

# Orígenes permitidos para CORS separados por comas (vacío = solo mismo origen)
CORS_ORIGINS=

# Contraseñas de las cuentas demo que crea `npm run seed:supabase`
DEMO_ADMIN_PASSWORD=
DEMO_SERENAZGO_PASSWORD=
DEMO_VECINO_PASSWORD=
